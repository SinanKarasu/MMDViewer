			<array>
				<string>com.sinankarasu.mathpix-markdown</string>
				<string>uk.co.mikeosoft.mmd</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
